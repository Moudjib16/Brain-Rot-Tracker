{
  "manifest_version": 3,
  "name": "Brain Rot Tracker",
  "version": "1.0.0",
  "description": "Tracks active screen time and unique videos scrolled on video-heavy platforms like YouTube Shorts, TikTok, and Instagram Reels.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Brain Rot Tracker"
  }
}
